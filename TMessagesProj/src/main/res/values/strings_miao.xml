<?xml version="1.0" encoding="utf-8"?>
<!--
  MiaoGram custom strings - main module.

  This file holds string resources that are referenced by code in TMessagesProj
  (the library module), e.g. com.miaogram.miao.* classes.

  Strings here MUST NOT have the same name as any string in upstream
  TMessagesProj/src/main/res/values/strings.xml — that would cause a
  "Duplicate resources" build error.

  For overriding upstream strings (like AppName), use the OTHER strings_miao.xml
  in TMessagesProj_App/src/main/res/values/strings_miao.xml — only application
  modules can override library module resources.
-->
<resources>

    <!-- Settings page -->
    <string name="MiaoSettings">MiaoGram Settings</string>
    <string name="MiaoSettingsComingSoon">More options will land here in upcoming releases.</string>

    <!-- Account section -->
    <string name="MiaoAccountSectionInfo">Account</string>
    <string name="MiaoMaxAccounts">More accounts</string>
    <string name="MiaoMaxAccountsInfo">Allow up to 10 logged-in accounts</string>
    <string name="MiaoMaxAccountsHint">When enabled, you can add up to 10 accounts instead of the default 4. Restart the app after toggling.</string>
    <string name="MiaoAccountRemarkTitle">Account remark</string>

</resources>
