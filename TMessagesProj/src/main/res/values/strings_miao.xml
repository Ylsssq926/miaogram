<?xml version="1.0" encoding="utf-8"?>
<!--
  MiaoGram custom strings - main module.

  This file holds string resources that are referenced by code in TMessagesProj
  (the library module), e.g. com.miaogram.miao.* classes.

  Strings here MUST NOT have the same name as any string in upstream
  TMessagesProj/src/main/res/values/strings.xml — that would cause a
  "Duplicate resources" build error.

  For overriding upstream strings (like AppName), use the OTHER strings_miao.xml
  in TMessagesProj_App/src/main/res/values/strings_miao.xml — only application
  modules can override library module resources.
-->
<resources>

    <!-- Settings page -->
    <string name="MiaoSettings">MiaoGram Settings</string>
    <string name="MiaoSettingsComingSoon">More options will land here in upcoming releases.</string>

    <!-- Account section -->
    <string name="MiaoAccountSectionInfo">Account</string>
    <string name="MiaoMaxAccounts">More accounts</string>
    <string name="MiaoMaxAccountsInfo">Allow up to 10 logged-in accounts</string>
    <string name="MiaoMaxAccountsHint">When enabled, you can add up to 10 accounts instead of the default 4. Restart the app after toggling.</string>
    <string name="MiaoAccountRemarkTitle">Account remark</string>
    <string name="MiaoAccountRemark">Account remarks</string>
    <string name="MiaoAccountRemarkInfo">Long-press an account to set a local nickname</string>

    <!-- Folder section -->
    <string name="MiaoFolderSectionInfo">Folders</string>
    <string name="MiaoHideAllChats">Hide \"All Chats\" tab</string>
    <string name="MiaoHideAllChatsInfo">Remove the default All Chats folder tab</string>
    <string name="MiaoHideAllChatsHint">Hides the \"All Chats\" tab when you have other folders. Has no effect if you have no custom folders.</string>

    <!-- Interface section -->
    <string name="MiaoInterfaceSectionInfo">Interface</string>
    <string name="MiaoHideStories">Hide Stories</string>
    <string name="MiaoHideStoriesInfo">Hide the Stories bar at the top of the chat list</string>

    <!-- Privacy / gray-area section -->
    <string name="MiaoPrivacySectionInfo">Privacy &amp; Extras</string>
    <string name="MiaoBlockSponsored">Hide sponsored messages</string>
    <string name="MiaoBlockSponsoredInfo">Don\'t show channel ads</string>
    <string name="MiaoGhostMode">Ghost mode</string>
    <string name="MiaoGhostModeInfo">Don\'t send read receipts, typing or online status</string>
    <string name="MiaoBypassRestrictions">Allow saving restricted content</string>
    <string name="MiaoBypassRestrictionsInfo">Enable forward / save / screenshot in restricted chats</string>
    <string name="MiaoPrivacySectionHint">These options change how MiaoGram behaves toward Telegram servers and other users. Use at your own discretion.</string>

</resources>
